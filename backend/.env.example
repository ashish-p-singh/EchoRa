# ECHORA Configuration
# Generated by `npm run setup` or manually configured.

# Google Gemini API Key (Primary Provider, 1st preference)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Grok (xAI) API Key (Secondary Provider, 2nd preference)
GROK_API_KEY=
